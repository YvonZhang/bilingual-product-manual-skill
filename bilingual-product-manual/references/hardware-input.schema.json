{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed bilingual hardware documents input",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "templates": {
      "type": "array",
      "items": {
        "enum": [
          "hardware-brochure",
          "hardware-specification"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "fictional": {
      "type": "boolean"
    },
    "meta": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/$defs/pair"
        },
        "short_title": {
          "$ref": "#/$defs/pair"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "$ref": "#/$defs/pair"
        },
        "overview": {
          "$ref": "#/$defs/pair"
        },
        "ordering": {
          "$ref": "#/$defs/pair"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "product",
        "model",
        "version",
        "overview",
        "sources"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/pair"
        },
        "logo": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "$ref": "#/$defs/pair"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "properties": {
        "hero": {
          "$ref": "#/$defs/image"
        },
        "detail": {
          "$ref": "#/$defs/image"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "$ref": "#/$defs/pair"
          },
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "unit_label": {
            "$ref": "#/$defs/pair"
          }
        },
        "required": [
          "id",
          "label",
          "fact"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    },
    "spec_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "$ref": "#/$defs/pair"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/row"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "rows"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/pair"
        },
        "intro": {
          "$ref": "#/$defs/pair"
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          },
          "minItems": 2,
          "maxItems": 4
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cells": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/pair"
                },
                "minItems": 2,
                "maxItems": 4
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "cells",
              "sources"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "conditions": {
          "$ref": "#/$defs/pair"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "intro",
        "headers",
        "rows",
        "conditions",
        "sources"
      ],
      "additionalProperties": false
    },
    "brochure": {
      "type": "object",
      "properties": {
        "hero": {
          "$ref": "#/$defs/blurb"
        },
        "design": {
          "$ref": "#/$defs/blurb"
        },
        "parameter_columns": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "minItems": 2,
          "maxItems": 2
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 4,
          "uniqueItems": true
        },
        "application_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 4,
          "uniqueItems": true
        },
        "closing": {
          "type": "object",
          "properties": {
            "title": {
              "$ref": "#/$defs/pair"
            },
            "text": {
              "$ref": "#/$defs/pair"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "title",
            "text",
            "sources"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "hero",
        "design",
        "parameter_columns",
        "feature_ids",
        "application_ids"
      ],
      "additionalProperties": false
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "omit",
              "internal"
            ]
          }
        },
        "required": [
          "field",
          "reason",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "font_family": {
          "type": "string",
          "minLength": 1
        },
        "logo_visible_width_mm": {
          "type": "number",
          "minimum": 12,
          "maximum": 40
        },
        "colors": {
          "type": "object",
          "properties": {
            "ink": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            },
            "pale": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            },
            "line": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "templates",
    "meta",
    "sources",
    "spec_groups"
  ],
  "additionalProperties": false,
  "$defs": {
    "pair": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fictional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "value",
        "sources"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/pair"
        },
        "value": {
          "$ref": "#/$defs/pair"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "sources"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/pair"
        },
        "text": {
          "$ref": "#/$defs/pair"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "sources"
      ],
      "additionalProperties": false
    },
    "blurb": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "$ref": "#/$defs/pair"
        },
        "title": {
          "$ref": "#/$defs/pair"
        },
        "text": {
          "$ref": "#/$defs/pair"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "text",
        "sources"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "$ref": "#/$defs/pair"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "interface_check": {
          "enum": [
            "matched",
            "not_applicable"
          ]
        },
        "review_notes": {
          "$ref": "#/$defs/pair"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "path",
        "model",
        "interface_check",
        "review_notes",
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "templates": {
            "contains": {
              "const": "hardware-brochure"
            }
          }
        }
      },
      "then": {
        "required": [
          "brochure"
        ]
      }
    }
  ]
}
