{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bilingual software manual input",
  "description": "Single evidence-backed content model for paired Chinese and English manuals.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "template": {
      "const": "software-manual"
    },
    "fictional": {
      "type": "boolean"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "brand": {
      "$ref": "#/$defs/brand"
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      },
      "minItems": 0
    },
    "theme": {
      "$ref": "#/$defs/theme"
    }
  },
  "required": [
    "schema_version",
    "template",
    "meta",
    "sources",
    "sections"
  ],
  "additionalProperties": false,
  "$defs": {
    "pair": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fictional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "sources": {
          "$ref": "#/$defs/refs"
        }
      },
      "required": [
        "value",
        "sources"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/$defs/pair"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 59
        },
        "intro": {
          "$ref": "#/$defs/pair"
        },
        "title": {
          "$ref": "#/$defs/pair"
        },
        "short_title": {
          "$ref": "#/$defs/pair"
        },
        "applies_to": {
          "$ref": "#/$defs/pair"
        }
      },
      "required": [
        "product",
        "version",
        "intro"
      ],
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/pair"
        },
        "contact": {
          "$ref": "#/$defs/pair"
        },
        "logo": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "fonts": {
          "type": "object",
          "properties": {
            "latin": {
              "type": "string",
              "minLength": 1
            },
            "cjk": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "text_color": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "caption_color": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "table_header_fill": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "table_border": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "toc_depth": {
          "enum": [
            1,
            2
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "omit",
            "internal"
          ]
        }
      },
      "required": [
        "field",
        "reason",
        "action"
      ],
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "sources": {
              "$ref": "#/$defs/refs"
            },
            "text": {
              "$ref": "#/$defs/pair"
            }
          },
          "required": [
            "type",
            "sources",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "step"
            },
            "sources": {
              "$ref": "#/$defs/refs"
            },
            "text": {
              "$ref": "#/$defs/pair"
            }
          },
          "required": [
            "type",
            "sources",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "note"
            },
            "sources": {
              "$ref": "#/$defs/refs"
            },
            "text": {
              "$ref": "#/$defs/pair"
            }
          },
          "required": [
            "type",
            "sources",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "code"
            },
            "sources": {
              "$ref": "#/$defs/refs"
            },
            "text": {
              "$ref": "#/$defs/pair"
            }
          },
          "required": [
            "type",
            "sources",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "figure"
            },
            "sources": {
              "$ref": "#/$defs/refs"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "zh": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "zh",
                    "en"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "caption": {
              "$ref": "#/$defs/pair"
            },
            "alt": {
              "$ref": "#/$defs/pair"
            },
            "width_in": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 6.9
            }
          },
          "required": [
            "type",
            "sources",
            "id",
            "path",
            "caption",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "table"
            },
            "sources": {
              "$ref": "#/$defs/refs"
            },
            "caption": {
              "$ref": "#/$defs/pair"
            },
            "headers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pair"
              },
              "minItems": 2,
              "maxItems": 6
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/pair"
                },
                "minItems": 2,
                "maxItems": 6
              },
              "minItems": 1
            },
            "widths": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 2,
              "maxItems": 6
            }
          },
          "required": [
            "type",
            "sources",
            "headers",
            "rows"
          ],
          "additionalProperties": false
        }
      ]
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,30}$"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "title": {
          "$ref": "#/$defs/pair"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 0
        },
        "page_break": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "level",
        "title",
        "blocks"
      ],
      "additionalProperties": false
    }
  }
}